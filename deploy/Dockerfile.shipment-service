# Node Alpine runtime for loopback shipment flow service (Port 5171)
FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json* ./
COPY packages/shipment-flow/ ./packages/shipment-flow/
COPY packages/suite-dock/ ./packages/suite-dock/

RUN npm install --workspace=packages/shipment-flow --omit=dev --ignore-scripts

EXPOSE 5171

CMD ["node", "packages/shipment-flow/src/server.mjs"]
