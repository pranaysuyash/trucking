# Multi-Stage Production Dockerfile for Sovereign Trucking Subproducts
# Stage 1: Build static assets using Node Alpine
# Stage 2: Serve via hardened Nginx Alpine

FROM node:22-alpine AS builder

WORKDIR /app

# Copy root workspace configurations
COPY package.json package-lock.json* ./
COPY packages/ ./packages/
COPY scripts/ ./scripts/

# Copy target product (passed via build-arg)
ARG PRODUCT_DIR
COPY ${PRODUCT_DIR}/ ./target-product/

# Install dependencies and build
RUN npm install --workspace=${PRODUCT_DIR} --ignore-scripts
WORKDIR /app/target-product
RUN npm run build

# Stage 2: Production Nginx Runtime
FROM nginx:1.27-alpine

COPY --from=builder /app/target-product/dist /usr/share/nginx/html
COPY deploy/nginx/nginx.conf /etc/nginx/nginx.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
